  "reglesHtml": "\n      <h3>Vocabulaire &amp; Dictionnaire personnel (FR ↔ IT)</h3>\n      <p style=\"font-size:13px;\">Répertoire unifié de vocabulaire thématique et ajouts personnels, classés par <b>catégorie</b> et <b>sous-catégorie</b>.</p>\n      <table class=\"regles-table\">\n        <thead><tr><th>Règle / Repère</th><th>Singulier</th><th>Pluriel / Remarque</th></tr></thead>\n        <tbody>\n          <tr>\n            <td><b>Pluriels irréguliers en -a (corps humain)</b></td>\n            <td>il braccio • il dito • il ginocchio • il labbro</td>\n            <td><b>le braccia • le dita • le ginocchia • le labbra</b> (féminin pluriel)</td>\n          </tr>\n          <tr>\n            <td><b>Féminin en -o / Double genre</b></td>\n            <td>la mano • l'orecchio (m.) / l'orecchia (f.)</td>\n            <td><b>le mani</b> • <b>le orecchie</b> (f.) / <b>gli orecchi</b> (m.)</td>\n          </tr>\n        </tbody>\n      </table>\n    ",
